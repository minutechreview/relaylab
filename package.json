{
  "name": "relaylab",
  "version": "0.1.0",
  "private": true,
  "description": "A WebMCP-native B-roll overlay editor for human-agent collaboration.",
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:webmcp:smoke": "npx --yes webmcp-evals@0.0.4 --chrome-channel chrome smoke -u http://127.0.0.1:3000/demo -e tests/webmcp-evals/relaylab.json -v"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fal-ai/client": "^1.10.1",
    "next": "16.3.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.5.2",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@playwright/test": "1.62.1",
    "@tailwindcss/postcss": "4.3.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@types/node": "24.10.1",
    "@types/react": "19.2.8",
    "@types/react-dom": "19.2.3",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "tailwindcss": "4.3.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "webmcp-types": "0.1.5"
  }
}
