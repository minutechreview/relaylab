# The deterministic /demo project works without credentials.

# Optional fal.ai video fallback. Both values are required before the human
# Generate Clip button can call the server route. No default model is assumed.
# Choose a current text-to-video model that accepts prompt, duration, and
# aspect_ratio through @fal-ai/client.
FAL_KEY=
FAL_VIDEO_MODEL=
# Remote paid generation is denied even when credentials exist unless this is
# explicitly set to true. Keep false/unset on a public unauthenticated demo.
FAL_ALLOW_REMOTE_GENERATION=false

# Uploaded-footage-first decision threshold. 0.65 is deliberately pragmatic,
# configurable, and not presented as a scientific confidence score.
NEXT_PUBLIC_BROLL_MATCH_THRESHOLD=0.65

# Optional analysis providers. They are not called by the deterministic demo
# or by the current local-upload path.
OPENAI_API_KEY=
RELAYLAB_TRANSCRIPTION_MODEL=whisper-1
RELAYLAB_VISION_MODEL=
# Keep remote paid transcription disabled on a public unauthenticated demo.
OPENAI_ALLOW_REMOTE_TRANSCRIPTION=false
